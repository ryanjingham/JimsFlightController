<Window x:Class="MSFS2024Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MSFS2024Companion"
        xmlns:vm="clr-namespace:JimsFlightController.ViewModels"
        xmlns:converters="clr-namespace:JimsFlightController.Converters"
        mc:Ignorable="d"
        Title="MSFS 2024 Companion" Height="600" Width="450"
        Background="#FF1E1E1E">
    <Window.Resources>
        <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3E3E42"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF007ACC"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3F3F46"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Connection Status -->
        <GroupBox Grid.Row="0" Header="Connection" Padding="10">
            <StackPanel>
                <TextBlock Text="{Binding ConnectionStatus}" FontSize="14" FontWeight="Bold" 
                          HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Connect" Command="{Binding ConnectCommand}" Width="100"/>
                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Width="100"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Telemetry -->
        <GroupBox Grid.Row="1" Header="Telemetry" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Position:" Margin="0,5"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="10,5">
                    <Run Text="{Binding LatitudeDisplay, Mode=OneWay}"/>
                    <Run Text=" "/>
                    <Run Text="{Binding LongitudeDisplay, Mode=OneWay}"/>
                </TextBlock>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Altitude:" Margin="0,5"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AltitudeFeet, StringFormat='{}{0:F0} ft'}" Margin="10,5" FontSize="16" FontWeight="Bold"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ground Speed:" Margin="0,5"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GroundSpeed, StringFormat='{}{0:F0} kts'}" Margin="10,5" FontSize="16" FontWeight="Bold"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Heading:" Margin="0,5"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Heading, StringFormat='{}{0:F0}°'}" Margin="10,5" FontSize="16" FontWeight="Bold"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Vertical Speed:" Margin="0,5"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding VerticalSpeed, StringFormat='{}{0:F0} fpm'}" Margin="10,5"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Autopilot:" Margin="0,5"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ApStatusDisplay}" Margin="10,5" FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ApMaster}" Value="True">
                                    <Setter Property="Foreground" Value="#FF00FF00"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ApMaster}" Value="False">
                                    <Setter Property="Foreground" Value="#FFFF0000"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </GroupBox>

        <!-- Autopilot Control -->
        <GroupBox Grid.Row="2" Header="Autopilot Control" Padding="10">
            <StackPanel>
                <Button Content="TOGGLE AP MASTER" Command="{Binding ToggleAutopilotCommand}" 
                        FontSize="14" FontWeight="Bold" Margin="5,5,5,15"/>

                <!-- Heading -->
                <Border BorderBrush="#FF3F3F46" BorderThickness="1" Padding="10" Margin="0,5">
                    <StackPanel>
                        <TextBlock Text="HEADING" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TargetHeading, UpdateSourceTrigger=PropertyChanged}" 
                                    FontSize="16" TextAlignment="Center"/>
                            <Button Grid.Column="1" Content="SET HDG" Command="{Binding SetHeadingCommand}" Width="80"/>
                            <Button Grid.Column="2" Command="{Binding EnableHeadingModeCommand}" Width="80">
                                <TextBlock>
                                    <Run Text="HDG"/>
                                    <Run Text="{Binding HeadingMode, Converter={StaticResource BoolToStatusConverter}}" FontWeight="Bold"/>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding SelectedHeading, StringFormat='Selected: {0:F0}�'}" 
                                  FontSize="10" Margin="0,5,0,0" Opacity="0.7"/>
                    </StackPanel>
                </Border>

                <!-- Altitude -->
                <Border BorderBrush="#FF3F3F46" BorderThickness="1" Padding="10" Margin="0,5">
                    <StackPanel>
                        <TextBlock Text="ALTITUDE" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TargetAltitude, UpdateSourceTrigger=PropertyChanged}" 
                                    FontSize="16" TextAlignment="Center"/>
                            <Button Grid.Column="1" Content="SET ALT" Command="{Binding SetAltitudeCommand}" Width="80"/>
                            <Button Grid.Column="2" Command="{Binding EnableAltitudeModeCommand}" Width="80">
                                <TextBlock>
                                    <Run Text="ALT"/>
                                    <Run Text="{Binding AltitudeMode, Converter={StaticResource BoolToStatusConverter}}" FontWeight="Bold"/>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding SelectedAltitude, StringFormat='Selected: {0:F0} ft'}" 
                                  FontSize="10" Margin="0,5,0,0" Opacity="0.7"/>
                    </StackPanel>
                </Border>

                <!-- Vertical Speed -->
                <Border BorderBrush="#FF3F3F46" BorderThickness="1" Padding="10" Margin="0,5">
                    <StackPanel>
                        <TextBlock Text="VERTICAL SPEED" FontWeight="Bold" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TargetVerticalSpeed, UpdateSourceTrigger=PropertyChanged}" 
                                    FontSize="16" TextAlignment="Center"/>
                            <Button Grid.Column="1" Content="SET VS" Command="{Binding SetVerticalSpeedCommand}" Width="80"/>
                            <Button Grid.Column="2" Command="{Binding EnableVerticalSpeedModeCommand}" Width="80">
                                <TextBlock>
                                    <Run Text="VS"/>
                                    <Run Text="{Binding VerticalSpeedMode, Converter={StaticResource BoolToStatusConverter}}" FontWeight="Bold"/>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- NAV Mode -->
                <Border BorderBrush="#FF3F3F46" BorderThickness="1" Padding="10" Margin="0,5">
                    <Button Command="{Binding EnableNavModeCommand}">
                        <TextBlock FontSize="14">
                            <Run Text="NAV"/>
                            <Run Text="{Binding NavMode, Converter={StaticResource BoolToStatusConverter}}" FontWeight="Bold"/>
                        </TextBlock>
                    </Button>
                </Border>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
